<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EB04080B" />
            <stroke android:width="1dp" android:color="#59F0FF00" />
        </shape>
    </item>
    <!-- 2dp accent bar on the left, like the in-app cards -->
    <item android:gravity="start|fill_vertical" android:width="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F0FF00" />
        </shape>
    </item>
</layer-list>
